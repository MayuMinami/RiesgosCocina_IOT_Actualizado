<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/energia"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rosa_fondo"
    android:orientation="vertical"
    android:padding="20dp"
    tools:context=".EnergiaActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/TituloPantalla"
                android:text="@string/energia_titulo" />

            <TextView
                style="@style/TarjetaMenuTexto"
                android:layout_marginBottom="12dp"
                android:text="@string/energia_descripcion" />

            <TextView
                android:id="@+id/tvTemaActual"
                style="@style/Subtitulo"
                android:layout_marginTop="4dp"
                tools:text="Tema actual: oscuro" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTemaClaro"
                style="@style/BotonBorde"
                android:text="@string/btn_tema_claro" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTemaOscuro"
                style="@style/BotonBorde"
                android:text="@string/btn_tema_oscuro" />

            <TextView
                style="@style/Subtitulo"
                android:text="@string/energia_medicion" />

            <com.google.android.material.card.MaterialCardView
                style="@style/TarjetaMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout style="@style/TarjetaMenuContenido">

                    <TextView
                        android:id="@+id/tvEstadoMedicion"
                        style="@style/TarjetaMenuTitulo"
                        android:textSize="15sp"
                        android:text="@string/energia_listo" />

                    <TextView
                        android:id="@+id/tvDetalleMedicion"
                        style="@style/TarjetaMenuTexto"
                        android:text="@string/energia_aviso" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMedir1"
                style="@style/BotonRosa"
                android:layout_marginTop="0dp"
                android:text="@string/btn_medir_1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMedir5"
                style="@style/BotonRosa"
                android:text="@string/btn_medir_5" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelarMedicion"
                style="@style/BotonBorde"
                android:text="@string/btn_cancelar_medicion"
                android:visibility="gone" />

            <TextView
                style="@style/Subtitulo"
                android:text="@string/energia_resultados" />

            <com.google.android.material.card.MaterialCardView
                style="@style/TarjetaMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvResultados"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="4dp"
                    android:padding="16dp"
                    android:text="@string/energia_sin_resultados"
                    android:textColor="@color/borgona"
                    android:textSize="13sp" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBorrarResultados"
                style="@style/BotonBorde"
                android:text="@string/btn_borrar_resultados" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
