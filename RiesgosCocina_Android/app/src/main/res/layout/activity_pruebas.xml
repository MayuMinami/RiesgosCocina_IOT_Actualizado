<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/pruebas"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rosa_fondo"
    android:orientation="vertical"
    android:padding="20dp"
    tools:context=".PruebasActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/TituloPantalla"
                android:text="@string/pruebas_titulo" />

            <TextView
                android:id="@+id/tvConexion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="● ESP32 en línea · MQTT con TLS" />

            <TextView
                style="@style/TarjetaMenuTexto"
                android:layout_marginBottom="12dp"
                android:text="@string/pruebas_descripcion" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEjecutarPruebas"
                style="@style/BotonRosa"
                android:text="@string/btn_ejecutar_pruebas" />

            <TextView
                android:id="@+id/tvResumen"
                style="@style/Subtitulo"
                android:layout_marginTop="8dp" />

            <com.google.android.material.card.MaterialCardView
                style="@style/TarjetaMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvResultados"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:text="@string/pruebas_vacio"
                    android:textColor="@color/borgona"
                    android:textSize="13sp" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
